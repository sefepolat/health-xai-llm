# ==============================================================
# .env.example
# Gerçek .env dosyası için şablon — değerleri doldurup
# ".env" adıyla kaydet. Bu dosyayı Git'e commit'leyebilirsin.
# ==============================================================

# --- LLM Backend Seçimi: "openai" veya "ollama" ---
LLM_BACKEND=ollama

# --- OpenAI API Ayarları (LLM_BACKEND=openai ise doldur) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.3

# --- Ollama Ayarları (LLM_BACKEND=ollama ise doldur) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.3

# --- Loglama ---
LOG_LEVEL=INFO
